# VaaniSetu Environment Configuration

# Backend integration endpoint (Member 3)
VITE_API_BASE_URL=http://localhost:8000

# Set to false once the backend booking server is active
VITE_DEMO_MODE=true

# Public frontend defaults only. Keep ElevenLabs credentials on the backend.
# The backend must return a signed URL or conversation token for live sessions.
VITE_ELEVENLABS_AGENT_ID=clinic_receptionist_aarogya

# Curated ElevenLabs Voice ID (Riya — Hindi/English bilingual: 21m00Tcm4TlvDq8ikWAM)
VITE_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Backend-only values. Put these in backend/.env or the server environment,
# never in the Vite frontend environment.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173
